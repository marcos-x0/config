#!/usr/bin/env bash

# ============================================================================
# WARNING: DO NOT MODIFY UNLESS YOU KNOW WHAT YOU'RE DOING
# This section handles devbox environment activation and PATH priority
# Modifying this code may break tool version isolation between projects
# ============================================================================

# Activate all devbox environments in the correct order.
#
# DEVBOX_DIRS is built by .envrc.default as the direnv chain walks up from
# the target directory. It arrives here in shallowest-to-deepest order.
# We prepend <project-root> so it activates first (lowest PATH priority).
# Each eval prepends to PATH, so the last one activated (deepest) wins.
#
# Example: cd <project-root>/platform/packages/ui/
#   DEVBOX_DIRS before: "platform:ui"
#   DEVBOX_DIRS after:  "<project-root>:platform:ui"
#   Activation order:   <project-root> → platform → ui
#   PATH result:        ui paths > platform paths > <project-root> paths

# Get the root directory path
export ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Prepend root so it is activated first (lowest priority on PATH)
export DEVBOX_DIRS="$ROOT_DIR${DEVBOX_DIRS:+:$DEVBOX_DIRS}"

# Activate each devbox environment and verify activation succeeded
for dir in $(echo "$DEVBOX_DIRS" | tr ":" "\n"); do
  echo "Activating devbox from $dir"
  eval "$(devbox generate direnv --print-envrc --config "$dir")"

  # Verify devbox activation succeeded by checking if .devbox path is in PATH
  EXPECTED_DEVBOX_PATH="$dir/.devbox/nix"
  if ! echo "$PATH" | grep -q "$EXPECTED_DEVBOX_PATH"; then
    # Display error in red bold text: \033[1;31m = bold red, \033[0m = reset colors
    printf "\033[1;31m[✗] *** DEVBOX ACTIVATION FAILED for %s ***\033[0m\n\n" "$dir" >&2
  fi
done

# ============================================================================
# SAFE TO CHANGE FROM THIS POINT ON
# ============================================================================

# check out https://www.jetpack.io/devbox/docs/ide_configuration/direnv/
# for more details

source_env_if_exists ~/.envrc

