// Minimal Zellij configuration with just tabs visible
// ~/.config/zellij/config.kdl

// Disable frames around panes
pane_frames false
default_shell "fish"
// default_shell "zsh -c fish"
// Use a minimal default layout
// default_layout "./compact.kdl"

// Add Nord theme configuration
themes {
    nord_c {
        text_unselected {
            base 229 233 240
            background 59 66 82
            emphasis_0 208 135 112
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        text_selected {
            base 229 233 240
            background 59 66 82
            emphasis_0 208 135 112
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        ribbon_selected {
            base 59 66 82
            background 163 190 140
            emphasis_0 191 97 106
            emphasis_1 208 135 112
            emphasis_2 180 142 173
            emphasis_3 129 161 193
        }
        ribbon_unselected {
            base 59 66 82
            background 216 222 233
            emphasis_0 191 97 106
            emphasis_1 229 233 240
            emphasis_2 129 161 193
            emphasis_3 180 142 173
        }
        table_title {
            base 163 190 140
            background 0
            emphasis_0 208 135 112
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        table_cell_selected {
            base 229 233 240
            background 46 52 64
            emphasis_0 208 135 112
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        table_cell_unselected {
            base 229 233 240
            background 59 66 82
            emphasis_0 208 135 112
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        list_selected {
            base 229 233 240
            background 46 52 64
            emphasis_0 208 135 112
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        list_unselected {
            base 229 233 240
            background 59 66 82
            emphasis_0 208 135 112
            emphasis_1 136 192 208
            emphasis_2 163 190 140
            emphasis_3 180 142 173
        }
        frame_selected {
            base 123 136 161
            background 0
            emphasis_0 208 135 112
            emphasis_1 136 192 208
            emphasis_2 180 142 173
            emphasis_3 0
        }
frame_unselected {
            base 123 136 161
            background 0
            emphasis_0 208 135 112
            emphasis_1 136 192 208
            emphasis_2 180 142 173
            emphasis_3 0
        }



        frame_highlight {
            base 208 135 112
            background 0
            emphasis_0 208 135 112
            emphasis_1 208 135 112
            emphasis_2 208 135 112
            emphasis_3 208 135 112
        }
        exit_code_success {
            base 163 190 140
            background 0
            emphasis_0 136 192 208
            emphasis_1 59 66 82
            emphasis_2 180 142 173
            emphasis_3 129 161 193
        }
        exit_code_error {
            base 191 97 106
            background 0
            emphasis_0 235 203 139
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 180 142 173
            player_2 129 161 193
            player_3 0
            player_4 235 203 139
            player_5 136 192 208
            player_6 0
            player_7 191 97 106
            player_8 0
            player_9 0
            player_10 0
        }
    }
}

theme "nord_c"


// Clear all default keybindings and define only what we need
keybinds clear-defaults=true {
    normal {
        // Tab management

        bind "Super t" { NewTab; }
        bind "Alt w" { CloseTab; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Super Alt Left" { GoToPreviousTab; }
        bind "Super Alt Right" { GoToNextTab; }

        bind "Super Shift f" {ToggleFocusFullscreen; }

        // Pane management
        bind "Super -" { NewPane "Down"; }
        bind "Super \\" { NewPane "Right"; }
        bind "Super x" { CloseFocus; }
       
        // NavSuper igation between panes
        bind "Super Left" { MoveFocus "Left"; }
        bind "Super Down" { MoveFocus "Down"; }
        bind "Super Up" { MoveFocus "Up"; }
        bind "Super Right" { MoveFocus "Right"; }



        // Quit Zellij
        bind "Ctrl q" { Quit; }

        bind "Alt r" { SwitchToMode "resize"; }
    }

    resize {
        bind "Alt r" { SwitchToMode "normal"; }
        bind "Alt  Left" { Resize "Left"; }
        bind "Alt Down" { Resize "Down"; }
        bind "Alt Up" { Resize "Up"; }
        bind "Alt Right" { Resize "Right"; }
      }
}

plugins {
    zj-status-bar location="file:/Users/mgj/.config/zellij/zj-status-bar.wasm"
}
// Only enable the tab bar plugin
plugins {
    tab-bar location="zellij:tab-bar"
}

// Configure the tab-bar to be minimal
ui {
    pane_frames {
        hide_session_name true
                tab_active   "#[fg=#9399B2,bold,italic] {name} "
    }
    status_bar {
        show false
    }
}



// Disable auto layout to prevent Zellij from enforcing layouts
auto_layout false

// Disable session serialization for simplicity
//session_serialization false

// Disable startup tips
show_startup_tips false

